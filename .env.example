# ===========================================
# VEDANT ACADEMY - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to GitHub!

# ---------- DATABASE ----------
# For LOCAL development (SQLite):
DATABASE_URL=file:./dev.db

# For PRODUCTION (Supabase PostgreSQL):
# Get this from: Supabase Dashboard → Settings → Database → Connection string → URI
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ---------- SUPABASE ----------
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------- RAZORPAY ----------
# Get these from: Razorpay Dashboard → Settings → API Keys
# Use TEST keys during development, LIVE keys for production
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret_here

# ---------- ADMIN ----------
# Set a strong password for your admin panel
ADMIN_PASSWORD=admin123

# ---------- APP SETTINGS ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
