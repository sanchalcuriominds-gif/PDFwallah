# ===========================================
# VEDANT ACADEMY - ENVIRONMENT VARIABLES
# ===========================================
# These go in Vercel → Settings → Environment Variables
# DO NOT put real values in this file on GitHub!

# ---------- DATABASE (Supabase) ----------
# DATABASE_URL = Pooler connection (for queries from Vercel serverless)
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
#
# DIRECT_URL = Direct connection (for Prisma migrations)
# Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# ---------- SUPABASE ----------
# NEXT_PUBLIC_SUPABASE_URL = https://PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY = eyJ... (from Settings → API → anon public)
# SUPABASE_SERVICE_ROLE_KEY = eyJ... (from Settings → API → service_role)

# ---------- RAZORPAY ----------
# RAZORPAY_KEY_ID = rzp_test_xxxxx or rzp_live_xxxxx
# RAZORPAY_KEY_SECRET = your-secret-key

# ---------- ADMIN ----------
# ADMIN_PASSWORD = your-admin-password

# ---------- APP ----------
# NEXT_PUBLIC_APP_URL = https://your-site.vercel.app
